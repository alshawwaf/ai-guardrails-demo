# AI Guardrails Playground (+ Gateway Mode): environment template
#
#   cp .env.example .env      then fill in what you use
#
# Rules for this file
# - Nothing in here is a working secret. "set-me" marks a value you must supply.
#   Secret lines are either empty (NAME=) or commented out (# NAME=set-me).
#   An empty value means "not set": the app generates or refuses what it needs
#   and says so in the startup log.
# - Never commit .env. It is listed in .gitignore and .dockerignore.
# - Values that contain "$" (password hashes) must be wrapped in single quotes,
#   otherwise docker compose tries to expand them: NAME='value$with$dollars'
# - The aiguard command line tool does not read this file. Give it secrets
#   through hidden prompts or --*-env VAR options (see docs/GATEWAY_MODE.md).

# ---------------------------------------------------------------------------
# Sign-in (required)
# ---------------------------------------------------------------------------
# The only account. Sign-in is refused until DEFAULT_ADMIN_EMAIL and one of
# DEFAULT_ADMIN_PASSWORD / DEFAULT_ADMIN_PASSWORD_HASH are set.
DEFAULT_ADMIN_EMAIL=admin@example.com

# set-me: a long random password. "change_me_please" is refused.
DEFAULT_ADMIN_PASSWORD=

# Optional, preferred over a plain password: a werkzeug password hash.
# Generate it without the password landing in your shell history:
#   python -c "import getpass;from werkzeug.security import generate_password_hash as h;print(h(getpass.getpass()))"
# Paste it in single quotes. When set, DEFAULT_ADMIN_PASSWORD is not used.
DEFAULT_ADMIN_PASSWORD_HASH=

# ---------------------------------------------------------------------------
# Secrets the app keeps for itself
# ---------------------------------------------------------------------------
# set-me: Flask session signing key, 64 hex characters. Generate:
#   python -c "import secrets;print(secrets.token_hex(32))"
# At least 32 characters: a shorter value is ignored with a warning, like the
# old published placeholders. Empty (or ignored): the app creates
# instance/.flask_secret (mode 0600) on first start and logs a warning.
FLASK_SECRET_KEY=

# set-me: AES-256-GCM key that encrypts the API keys saved on the Settings page.
# Base64 of exactly 32 random bytes. Generate:
#   python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
# Empty: the app creates instance/.settings_key (mode 0600). Back up whichever
# key you use: saved API keys cannot be decrypted without it. A malformed value
# stops the app at startup.
# Saved keys are stored as enc:v2 (AES-256-GCM bound to the setting's name) and
# the Azure endpoints as mac:v1 (readable, integrity-tagged). Rows saved by an
# older version are upgraded once; instance/.settings_format records that, and
# afterwards older-format rows are ignored. To upgrade a database backup made
# before that, delete instance/.settings_format and restart. After an upgrade
# from plaintext, rotate those keys and delete the older backups (see
# docs/CONFIGURATION.md, "Secrets and Saved Settings").
SETTINGS_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# AI Guardrails (Lakera Guard) for the Playground and Benchmarking pages
# ---------------------------------------------------------------------------
# The Settings page overrides these. DEMO_API_KEY / DEMO_PROJECT_ID are read
# first if you set them; LAKERA_* are the fallback.
# LAKERA_API_KEY=set-me
# LAKERA_PROJECT_ID=set-me
# Full Guard URL including /v2/guard. DEMO_API_URL wins over LAKERA_API_URL.
LAKERA_API_URL=https://api.lakera.ai/v2/guard

# ---------------------------------------------------------------------------
# Target LLM providers (all optional; the Settings page overrides these)
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=set-me
OPENAI_API_URL=https://api.openai.com/v1/chat/completions

# ANTHROPIC_API_KEY=set-me

# AZURE_OPENAI_API_KEY=set-me
# https:// only (the key is sent in a header; an http:// endpoint is ignored)
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini-2024-07-18

# GEMINI_API_KEY=set-me

# Azure AI Content Safety (Benchmarking page only)
# AZURE_CONTENT_SAFETY_KEY=set-me
# https:// only, like AZURE_OPENAI_ENDPOINT
# AZURE_CONTENT_SAFETY_ENDPOINT=https://<resource>.cognitiveservices.azure.com

# Ollama (local LLM)
OLLAMA_API_URL=http://localhost:11434
OLLAMA_TIMEOUT=120
# Default local model for the "target LLM" in scans. An uncensored model is
# intentional here: it complies with jailbreaks when Guard is off, which is
# what makes Guard's block visible. The settings DB overrides this if set.
OLLAMA_MODEL=richardyoung/mythos-9b-unhinged-abliterated:latest

# Playground default LLM: what the UI opens with when the browser has no saved
# choice (a user's own selection still wins).
DEFAULT_LLM_PROVIDER=ollama
DEFAULT_LLM_MODEL=richardyoung/mythos-9b-unhinged-abliterated:latest

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_PORT=9000
LOGS_DIR=logs
LOG_FILENAME=application.log
# Optional: where the SQLite DB and the generated key files live (default ./instance)
# INSTANCE_DIR=
# Optional: largest accepted request body in bytes (default 2097152 = 2 MB)
# MAX_CONTENT_LENGTH=2097152

# Werkzeug debug mode (interactive debugger, auto-reload). Only "1" or "true"
# turn it on. Never on a host other people can reach.
FLASK_DEBUG=0

# Session cookies: set to true when users reach the app over HTTPS (for example
# behind a TLS reverse proxy). Leave false for plain-HTTP lab access.
SESSION_COOKIE_SECURE=false
# Reverse proxies in front of the app whose X-Forwarded-For / -Proto / -Host /
# -Port headers are trusted. The sign-in limit (10 attempts per minute) and the
# sign-in log lines use the client address worked out from them.
#   0  trust none: users reach the app port directly (python app.py, docker run,
#      docker compose up). Keep 0 here for Docker Compose: docker-compose.prod.yml
#      sets 1 for the app behind its nginx, and publishes the app port on
#      loopback only, by itself.
#   1  one proxy of your own in front (nginx, Traefik) that sets X-Forwarded-For.
#      Only if nothing but that proxy can reach the app port: a client that
#      connects directly could otherwise send its own X-Forwarded-For and pick
#      the address the sign-in limit counts.
TRUSTED_PROXY_HOPS=0

# Docker Compose only: uncomment to make every "docker compose" command in this
# folder use the production stack (nginx + backup) without typing -f twice.
# Separate the files with ";" instead of ":" on Windows.
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# CORS for /api/*: off by default. List explicit origins to allow, comma-separated,
# for example https://devhub.example.com. "*" is ignored (with a warning).
# Listed origins get credentials (call with credentials: 'include'). The session
# cookie is SameSite=Lax, so this works only for same-site origins (another
# subdomain or port of this site); cross-site callers get 401.
CORS_ORIGINS=

# Optional: the app's public origin(s), comma-separated, e.g. https://guardrails.example.com.
# POST/PUT/PATCH/DELETE must come from exactly this app's origin (scheme, host,
# port). Normally worked out per request (behind a proxy from X-Forwarded-*);
# set this for a proxy that drops the public port or scheme. A refused POST is
# logged with a hint to set TRUSTED_PROXY_HOPS or APP_ORIGIN.
APP_ORIGIN=

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_DAILY=1000000
RATE_LIMIT_HOURLY=100000
# memory:// for one process; redis://redis:6379/0 with the compose stack
RATE_LIMIT_STORAGE=memory://

# ---------------------------------------------------------------------------
# Gateway Mode (web console at /gateway) and the aiguard CLI
# ---------------------------------------------------------------------------
# Where run logs, reports and rollback points (state.json, no secrets) are kept.
# Empty: <app folder>/logs/aiguard for the web console (in Docker:
# /app/logs/aiguard, on the ./logs volume) and ~/.aiguard for the CLI.
# Point both at the same folder to roll back from the CLI what the web did.
# In Docker this is a path inside the container.
AIGUARD_HOME=
# This computer's IP address as the gateway sees it. Set it when the app runs
# behind NAT (for example Docker with bridge networking: the Docker host's IP),
# so the demo rule's scope and the log matching use the right address.
# Empty: detected automatically.
AIGUARD_LOCAL_IP=

# ---------------------------------------------------------------------------
# Server processes
# ---------------------------------------------------------------------------
# The Docker image runs "python app.py": one process, many threads. Gateway Mode
# keeps each signed-in user's management session in that process's memory, so
# if you run gunicorn instead (docker-compose-dev.yml does), keep ONE worker and
# use threads for concurrency.
GUNICORN_WORKERS=1
GUNICORN_THREADS=8
GUNICORN_TIMEOUT=300
GUNICORN_BIND=0.0.0.0:9000
